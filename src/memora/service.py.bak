from __future__ import annotations

import json
import re
import uuid
from datetime import datetime, timezone
from typing import Any

from .db import Database
from .providers import Summarizer


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str) -> str:
    return f"{prefix}_{uuid.uuid4().hex[:12]}"


def tokenize(value: str) -> set[str]:
    return {w.lower() for w in re.findall(r"[\w'-]{2,}", value)}


class MemoryService:
    def __init__(self, db: Database, summarizer: Summarizer):
        self.db = db
        self.summarizer = summarizer

    def create_agent(self, name: str, kind: str = "generic") -> str:
        agent_id = new_id("agt")
        with self.db.connect() as conn:
            row = conn.execute("SELECT id FROM agents WHERE name=?", (name,)).fetchone()
            if row:
                return row["id"]
            conn.execute(
                "INSERT INTO agents(id,name,kind,created_at) VALUES(?,?,?,?)",
                (agent_id, name, kind, now()),
            )
        return agent_id

    def create_project(self, name: str, root_path: str | None = None) -> str:
        project_id = new_id("prj")
        with self.db.connect() as conn:
            row = conn.execute("SELECT id FROM projects WHERE name=?", (name,)).fetchone()
            if row:
                return row["id"]
            conn.execute(
                "INSERT INTO projects(id,name,root_path,created_at) VALUES(?,?,?,?)",
                (project_id, name, root_path, now()),
            )
        return project_id

    def start_session(self, agent: str, project: str | None = None,
                      external_id: str | None = None, title: str | None = None) -> str:
        agent_id = self.create_agent(agent)
        project_id = self.create_project(project) if project else None
        session_id = new_id("ses")
        with self.db.connect() as conn:
            conn.execute(
                """INSERT INTO sessions(id,agent_id,project_id,external_id,title,started_at)
                   VALUES(?,?,?,?,?,?)""",
                (session_id, agent_id, project_id, external_id, title, now()),
            )
        return session_id

    def add_event(self, session_id: str, content: str, event_type: str = "note",
                  metadata: dict[str, Any] | None = None) -> str:
        event_id = new_id("evt")
        with self.db.connect() as conn:
            exists = conn.execute("SELECT id FROM sessions WHERE id=?", (session_id,)).fetchone()
            if not exists:
                raise ValueError(f"Unknown session: {session_id}")
            conn.execute(
                """INSERT INTO events(id,session_id,event_type,content,metadata_json,created_at)
                   VALUES(?,?,?,?,?,?)""",
                (event_id, session_id, event_type, content,
                 json.dumps(metadata or {}, ensure_ascii=False), now()),
            )
        return event_id

    def add_memory(self, content: str, project: str | None = None,
                   memory_type: str = "fact", importance: float = 0.5,
                   tags: list[str] | None = None, source: str = "user",
                   source_session_id: str | None = None, summary: str | None = None) -> str:
        if not isinstance(content, str) or not content.strip():
            raise ValueError("content must not be empty")

        if not 0 <= importance <= 1:
            raise ValueError("importance must be between 0 and 1")

        project_id = self.create_project(project) if project else None
        memory_id = new_id("mem")
        timestamp = now()

        with self.db.connect() as conn:
            conn.execute(
                """INSERT INTO memories
                   (id,project_id,source_session_id,memory_type,content,summary,importance,
                    tags_json,source,created_at,updated_at)
                   VALUES(?,?,?,?,?,?,?,?,?,?,?)""",
                (memory_id, project_id, source_session_id, memory_type, content, summary,
                 importance, json.dumps(tags or [], ensure_ascii=False), source,
                 timestamp, timestamp),
            )
        return memory_id

    async def summarize_session(self, session_id: str) -> tuple[str, str]:
        with self.db.connect() as conn:
            session = conn.execute(
                """SELECT s.id,p.name AS project_name FROM sessions s
                   LEFT JOIN projects p ON p.id=s.project_id WHERE s.id=?""",
                (session_id,),
            ).fetchone()
            if not session:
                raise ValueError(f"Unknown session: {session_id}")
            rows = conn.execute(
                "SELECT content FROM events WHERE session_id=? ORDER BY created_at",
                (session_id,),
            ).fetchall()
        if not rows:
            raise ValueError("Cannot summarize a session without events.")
        source_text = "\n".join(row["content"] for row in rows)
        summary = await self.summarizer.summarize(source_text)
        memory_id = self.add_memory(
            content=summary,
            project=session["project_name"],
            memory_type="session_summary",
            importance=0.8,
            source="summarizer",
            source_session_id=session_id,
            summary=summary[:500],
        )
        with self.db.connect() as conn:
            conn.execute("UPDATE sessions SET ended_at=? WHERE id=?", (now(), session_id))
        return memory_id, summary

    def search(self, query: str, project: str | None = None, limit: int = 10) -> list[dict]:
        query_terms = tokenize(query)
        if not query_terms:
            return []
        sql = """SELECT m.*, p.name AS project_name FROM memories m
                 LEFT JOIN projects p ON p.id=m.project_id"""
        params: list[Any] = []
        if project:
            sql += " WHERE p.name=?"
            params.append(project)
        sql += " ORDER BY m.created_at DESC LIMIT 1000"
        with self.db.connect() as conn:
            rows = conn.execute(sql, params).fetchall()
        scored = []
        for row in rows:
            haystack = " ".join([
                row["content"], row["summary"] or "", row["memory_type"],
                " ".join(json.loads(row["tags_json"])),
            ])
            terms = tokenize(haystack)
            overlap = len(query_terms & terms)
            if overlap:
                score = overlap / max(len(query_terms), 1) + row["importance"] * 0.15
                item = dict(row)
                item["tags"] = json.loads(item.pop("tags_json"))
                item["score"] = round(score, 4)
                scored.append(item)
        scored.sort(key=lambda item: (item["score"], item["created_at"]), reverse=True)
        return scored[:max(1, min(limit, 100))]

    def session_context(self, project: str | None = None, query: str = "",
                        limit: int = 8) -> str:
        memories = self.search(query or "decision project task", project, limit)
        if not memories:
            return "No relevant saved memories."
        return "\n".join(
            f"- [{m['memory_type']}] {m['content']}" for m in memories
        )
